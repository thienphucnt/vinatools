{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "showLineNumbers": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "*.db",
      "*.zip",
      "*.png",
      "*.log",
      "analytics.json",
      "sitemap.xml",
      "config.local.json",
      "repomix-output.*"
    ]
  }
}
